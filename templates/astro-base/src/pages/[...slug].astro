---
import fs from 'fs';
import path from 'path';
import { ConfigParser, resolveCascadingConfig } from 'lander-engine/resolver';
import { ClientRouter } from 'astro:transitions';
import '../registry-manifest'; 
import Registry from '../Registry.astro';
import ModalsContainer from '../ModalsContainer.astro';
import logo from '@assets/logo.svg';
import landerConfig from '../lander-config.json';

export async function getStaticPaths() {
  const nodeEnvJsonDir = process.env.LANDER_JSON_CONFIGS_DIR;
  const viteEnvJsonDir = import.meta.env.LANDER_JSON_CONFIGS_DIR;
  const jsonConfigsDir = nodeEnvJsonDir || viteEnvJsonDir || '';

  if (!jsonConfigsDir) {
    console.error('LANDER_JSON_CONFIGS_DIR is not defined');
    return [];
  }

  const parser = new ConfigParser(jsonConfigsDir);
  const campaigns = await parser.getCampaigns();
  const paths = [];

  // Read the normalized domain routing configuration
  let domainRouting: Record<string, { campaign: string; basePath: string; defaultStep?: string }> = {};
  try {
    const routingContent = fs.readFileSync(path.join(process.cwd(), 'src/domain-routing.json'), 'utf8');
    domainRouting = JSON.parse(routingContent);
  } catch (e) {
    console.warn('Could not read domain-routing.json, proceeding with defaults', e);
  }

  for (const campaignId of campaigns) {
    const base = await parser.loadCampaignBase(campaignId);

    // Load base mobile (device) overrides
    let mobileOverrides: any = {};
    try {
      mobileOverrides = await parser.loadOverrides(campaignId, 'mobile');
    } catch (e) {
      // Mobile overrides are optional
    }
    const hasMobile = Object.keys(mobileOverrides).length > 0;

    // Discover A/B variant subdirectories and load their overrides
    const variants = await parser.getVariants(campaignId);
    const variantOverridesMap: Record<string, any> = {};
    const variantMobileOverridesMap: Record<string, any> = {};

    for (const variant of variants) {
      try {
        variantOverridesMap[variant] = await parser.loadOverrides(campaignId, variant);
      } catch (e) {
        variantOverridesMap[variant] = {};
      }
      try {
        variantMobileOverridesMap[variant] = await parser.loadOverrides(campaignId, `${variant}/mobile`);
      } catch (e) {
        variantMobileOverridesMap[variant] = {};
      }
    }

    // Each campaign gets its own single basePath / campaignId segment
    const bp = `/${campaignId}`;
    const prefix = campaignId;

    /**
     * Build the resolved props for a single page path.
     * Priority: Base < Device (mobile) < Variant < Variant+Device
     */
    function buildProps(
      stepId: string,
      isMobile: boolean,
      variant: string | null,
      hasMobileRoute: boolean,
      basePath: string,
    ) {
      const deviceOverride   = isMobile ? mobileOverrides : undefined;
      const variantOverride  = variant ? variantOverridesMap[variant] : undefined;
      const variantMobileOv  = variant && isMobile ? variantMobileOverridesMap[variant] : undefined;

      const resolvedConfig = resolveCascadingConfig(
        base,
        deviceOverride,
        variantOverride,
        variantMobileOv,
      );

      return {
        campaignId,
        stepId,
        isMobile,
        variant,
        variants,
        hasMobileRoute,
        config: resolvedConfig,
        step: resolvedConfig.steps[stepId] ?? base.steps[stepId],
        flow: resolvedConfig.flow,
        allSteps: resolvedConfig.steps,
        modalConfigs: resolvedConfig.flow?.modals ?? {},
        layout: resolvedConfig.layout ?? {},
        basePath,
        domainRouting,
      };
    }

    // Campaign root → server-redirect to initial step (variant assignment happens client-side)
    const initialStepId = base.flow.initialStep;
    if (base.steps[initialStepId]) {
      const defaultProps = buildProps(initialStepId, false, null, hasMobile, bp);
      paths.push({
        params: { slug: prefix },
        props: {
          isRedirect: true,
          redirectTo: `${bp}/${initialStepId}`,
          campaignId,
          config: defaultProps.config,
          flow: defaultProps.flow,
          variants: defaultProps.variants,
          hasMobileRoute: defaultProps.hasMobileRoute,
          basePath: bp,
          domainRouting,
        },
      });
    }

    for (const [stepId] of Object.entries(base.steps)) {
      const stepType = base.flow.steps[stepId]?.type;
      // Popup steps render as modals inside normal pages — no dedicated routes
      if (stepType === 'popup') continue;

      const makeSlug = (suffix: string) => {
        return `${prefix}/${stepId}${suffix}`;
      };

      // 1. Base desktop
      paths.push({
        params: { slug: makeSlug('') },
        props: buildProps(stepId, false, null, hasMobile, bp),
      });

      // 2. Base mobile (only if a mobile/ directory exists)
      if (hasMobile) {
        paths.push({
          params: { slug: makeSlug('.mobile') },
          props: buildProps(stepId, true, null, hasMobile, bp),
        });
      }

      // 3. Variant routes
      for (const variant of variants) {
        const vmo = variantMobileOverridesMap[variant];
        // Generate a variant mobile route when the campaign has base mobile overrides
        // OR when this variant has its own mobile overrides.
        const hasVariantMobile = hasMobile || Object.keys(vmo).length > 0;

        // Variant desktop
        paths.push({
          params: { slug: makeSlug(`.${variant}`) },
          props: buildProps(stepId, false, variant, hasVariantMobile, bp),
        });

        // Variant mobile
        if (hasVariantMobile) {
          paths.push({
            params: { slug: makeSlug(`.${variant}.mobile`) },
            props: buildProps(stepId, true, variant, hasVariantMobile, bp),
          });
        }
      }
    }
  }

  return paths;
}

const {
  isRedirect = false,
  redirectTo = '',
  isMobile = false,
  variant = null,
  variants = [],
  hasMobileRoute = false,
  config = { theme: {}, seo: {} },
  step = { sections: [], seo: {}, state: {} },
  campaignId = '',
  stepId = '',
  flow = { steps: {} },
  allSteps = {},
  modalConfigs = {},
  layout = {},
  basePath = '',
  domainRouting = {},
} = Astro.props as any;

const redirectPageConfig = (landerConfig as any).redirectPage || {};
const redirectTheme = redirectPageConfig.theme || {};
const redirectComponent = redirectPageConfig.component;

// Collect popup steps for ModalsContainer
const availablePopups: Record<string, any> = {};
for (const [popupId, popupStepConfig] of Object.entries(allSteps)) {
  if (flow.steps[popupId]?.type === 'popup') {
    availablePopups[popupId] = popupStepConfig;
  }
}

// Map theme variables to CSS custom properties
const themeVars = {
  ...Object.entries((config.theme && config.theme.colors) || {}).reduce((acc, [key, val]) => {
    acc[`--color-${key}`] = val as string;
    return acc;
  }, {} as Record<string, string>),
  ...Object.entries((config.theme && config.theme.fonts) || {}).reduce((acc, [key, val]) => {
    acc[`--font-${key}`] = val as string;
    return acc;
  }, {} as Record<string, string>),
  ...Object.entries((config.theme && config.theme.spacing) || {}).reduce((acc, [key, val]) => {
    acc[`--spacing-${key}`] = val as string;
    return acc;
  }, {} as Record<string, string>),
  ...Object.entries((config.theme && config.theme.borderRadius) || {}).reduce((acc, [key, val]) => {
    acc[`--border-radius-${key}`] = val as string;
    return acc;
  }, {} as Record<string, string>),
  ...Object.entries((config.theme && config.theme.tokens) || {}).reduce((acc, [key, val]) => {
    acc[`--token-${key}`] = val as string;
    return acc;
  }, {} as Record<string, string>),
};

const fontSources = (config.theme && config.theme.fontSources) || [];
const faviconHref = (config.theme && config.theme.favicon) || '/favicon.svg';
const faviconExt = faviconHref.split('?')[0].split('.').pop()?.toLowerCase() ?? '';
const faviconType: Record<string, string> = {
  svg:  'image/svg+xml',
  ico:  'image/x-icon',
  png:  'image/png',
  jpg:  'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
};
const faviconMime = faviconType[faviconExt] ?? 'image/x-icon';

const keywordsArray = (step.seo && step.seo.keywords) || (config.seo && config.seo.keywords);
const keywordsString = Array.isArray(keywordsArray) ? keywordsArray.join(', ') : keywordsArray;
const ogImageUrl = (step.seo && step.seo.ogImage) || (config.seo && config.seo.ogImage);
const canonicalUrl = (step.seo && step.seo.canonical) || (config.seo && config.seo.canonical);
const noindex = (step.seo && step.seo.noindex) ?? (config.seo && config.seo.noindex);
const scripts = layout?.scripts || [];
const headScripts = scripts.filter((s: any) => s.position === 'head');
const bodyStartScripts = scripts.filter((s: any) => s.position === 'body-start');
const bodyEndScripts = scripts.filter((s: any) => s.position === 'body-end');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {isRedirect ? (
      <>
        <title>{redirectTheme.title || "Redirecting..."}</title>
        <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
        <style define:vars={{ 
          bg: redirectTheme.backgroundColor || config.theme?.colors?.background || '#0f172a',
          spinner: redirectTheme.spinnerColor || config.theme?.colors?.primary || '#3b82f6',
          text: redirectTheme.textColor || config.theme?.colors?.text || '#f8fafc'
        }}>
          .redirect-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: var(--bg);
            font-family: system-ui, -apple-system, sans-serif;
            color: var(--text);
            margin: 0;
          }
          .redirect-card {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            padding: 2rem;
            border-radius: 1rem;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            animation: fadeIn 0.6s ease-out;
          }
          .spinner {
            width: 3.5rem;
            height: 3.5rem;
            border: 4px solid rgba(255, 255, 255, 0.1);
            border-left-color: var(--spinner);
            border-radius: 50%;
            animation: spin 1s linear infinite;
          }
          .redirect-text {
            font-size: 1.125rem;
            font-weight: 500;
            letter-spacing: -0.01em;
            margin: 0;
            opacity: 0.9;
          }
          @keyframes spin {
            to { transform: rotate(360deg); }
          }
          @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
          }
        </style>
      </>
    ) : (
      <>
        <link rel="icon" type={faviconMime} href={faviconHref} />
        {fontSources.map((source: string) => (
          <link rel="stylesheet" href={source} />
        ))}
        <title>{step.seo?.title || config.seo?.title}</title>
        <meta name="description" content={step.seo?.description || config.seo?.description} />
        {keywordsString && <meta name="keywords" content={keywordsString} />}
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
        {noindex && <meta name="robots" content="noindex" />}
        <style>body { visibility: hidden; }</style>
        <ClientRouter />
        {headScripts.map((s: any) => (
          <script src={s.src} async={s.async} defer={s.defer}></script>
        ))}
      </>
    )}
  </head>
  <body style={isRedirect ? undefined : themeVars}>
    {isRedirect ? (
      redirectComponent ? (
        <Registry component={redirectComponent} props={{ redirectTo, ...redirectPageConfig.props }} />
      ) : (
        <div class="redirect-container">
          <div class="redirect-card">
            <div class="spinner"></div>
            <p class="redirect-text">{redirectTheme.loadingText || "Redirecting..."}</p>
          </div>
        </div>
      )
    ) : (
      <>
        {bodyStartScripts.map((s: any) => (
          <script src={s.src} async={s.async} defer={s.defer}></script>
        ))}
        <img src={logo.src} alt="Logo" class="hidden lander-engine-logo" />
        {layout?.header && (
          <header id="lander-header">
            <Registry component={layout.header.component} props={layout.header.props} />
          </header>
        )}

        <main id="lander-engine-root">
          {step.sections.map((section: any) => (
            <Registry component={section.component} props={section.props} />
          ))}
        </main>

        {layout?.footer && (
          <footer id="lander-footer">
            <Registry component={layout.footer.component} props={layout.footer.props} />
          </footer>
        )}

        <ModalsContainer popups={availablePopups} modalConfigs={modalConfigs} />
      </>
    )}

    <script is:inline define:vars={{ variants, hasMobileRoute, campaignId, basePath, domainRouting, isRedirect, redirectTo }}>
      (function () {
        if (isRedirect) {
          if (!window.location.search.includes('no-redirect')) {
            window.location.replace(redirectTo + window.location.search);
          }
          return;
        }

        // Register config globally
        window.__landerCampaignConfigs = window.__landerCampaignConfigs || {};
        window.__landerCampaignConfigs[campaignId] = { variants: variants, hasMobileRoute: hasMobileRoute };
        window.__landerBasePath = window.__landerBasePath || basePath || '/' + campaignId;
        window.__landerDomainRouting = window.__landerDomainRouting || domainRouting || {};
      })();
    </script>

    <script>
      import { detectMobile, resolveUrl } from '../lib/routing';
      import { assignVariant } from '../lib/variants';
      import { performDomainRedirect, safeRedirect } from '../lib/redirect';
      import { rewriteLinks, setupLinkInterception, setupModalBackdrop } from '../lib/dom';
      import { navigate } from 'astro:transitions/client';

      // Setup window globals
      const container = document.querySelector('.redirect-container');
      if (container) {
        ;(window as any).__landerNavigate = () => {};
      } else {
        ;(window as any).__landerNavigate = navigate;

        // Populate resolved URL function using the library modules
        window.__landerResolveUrl = (pathname: string): string | null => {
          const pathParts = pathname.replace(/\/$/, '').split('/').filter(Boolean);

          // Find current campaign id
          let cId = '';
          const currentBasePath = window.__landerBasePath || '';
          if (currentBasePath === '/') {
            // Find campaignId from window configuration
            cId = Object.keys(window.__landerCampaignConfigs || {})[0] || '';
          } else {
            const bpSegments = currentBasePath.replace(/^\//, '').split('/');
            let match = true;
            for (let i = 0; i < bpSegments.length; i++) {
              if (pathParts[i] !== bpSegments[i]) {
                match = false;
                break;
              }
            }
            if (match && window.__landerCampaignConfigs) {
              cId = Object.keys(window.__landerCampaignConfigs)[0] || '';
            } else {
              cId = pathParts[0] || '';
            }
          }

          const config = window.__landerCampaignConfigs ? window.__landerCampaignConfigs[cId] : undefined;
          if (!config) return null;

          // Sticky variant lookup or assignment
          const activeVariant = assignVariant(cId, config.variants);
          const isMobile = detectMobile();

          if (pathParts.length === 0) {
            let defaultStep = 'main';
            if (window.__landerDomainRouting) {
              const hostname = window.location.hostname;
              const hostMapping = window.__landerDomainRouting[hostname];
              if (hostMapping && hostMapping.campaign === cId) {
                defaultStep = hostMapping.defaultStep || 'main';
              }
            }
            const rawUrl = `${currentBasePath}/${defaultStep}`;
            const resolved = resolveUrl(rawUrl, cId, currentBasePath, config, isMobile, activeVariant);
            return resolved;
          }

          return resolveUrl(pathname, cId, currentBasePath, config, isMobile, activeVariant);
        };

        // Perform initial domain redirect if needed
        const hostname = window.location.hostname;
        if (window.__landerDomainRouting) {
          const redirectTarget = performDomainRedirect(hostname, window.location.pathname, window.location.search, window.__landerDomainRouting);
          if (redirectTarget) {
            safeRedirect(redirectTarget + window.location.search + window.location.hash, new URL(window.location.href));
          }
        }

        // Perform redirect check (mobile/variants etc) synchronously on load
        if (!window.location.search.includes('no-redirect')) {
          const corrected = window.__landerResolveUrl(window.location.pathname);
          if (corrected) {
            safeRedirect(corrected + window.location.search + window.location.hash, new URL(window.location.href));
          } else {
            document.body.style.visibility = 'visible';
          }
        } else {
          document.body.style.visibility = 'visible';
        }

        // Setup DOM event listeners & link rewriting
        setupLinkInterception(window.__landerResolveUrl);
        setupModalBackdrop();

        document.addEventListener('astro:after-swap', () => {
          if (window.__landerResolveUrl && !window.__landerResolveUrl(window.location.pathname)) {
            document.body.style.visibility = 'visible';
          }
        });

        document.addEventListener('astro:page-load', () => {
          if (window.location.search.includes('no-redirect')) {
            document.body.style.visibility = 'visible';
            return;
          }

          if (window.__landerResolveUrl) {
            const corrected = window.__landerResolveUrl(window.location.pathname);
            if (corrected) {
              navigate(corrected + window.location.search + window.location.hash);
              return;
            }
          }

          document.body.style.visibility = 'visible';
          if (window.__landerResolveUrl) {
            rewriteLinks(window.__landerResolveUrl);
          }
        });
      }
    </script>
    {!isRedirect && bodyEndScripts.map((s: any) => (
      <script src={s.src} async={s.async} defer={s.defer}></script>
    ))}
  </body>
</html>