---
import fs from 'fs';
import path from 'path';
import { ConfigParser, resolveCascadingConfig } from 'lander-engine/resolver';
import { ViewTransitions } from 'astro:transitions';
import '../registry-manifest'; 
import Registry from '../Registry.astro';
import ModalsContainer from '../ModalsContainer.astro';

export async function getStaticPaths() {
  const nodeEnvJsonDir = process.env.LANDER_JSON_CONFIGS_DIR;
  const viteEnvJsonDir = import.meta.env.LANDER_JSON_CONFIGS_DIR;
  const jsonConfigsDir = nodeEnvJsonDir || viteEnvJsonDir || '';

  if (!jsonConfigsDir) {
    console.error('LANDER_JSON_CONFIGS_DIR is not defined');
    return [];
  }

  const parser = new ConfigParser(jsonConfigsDir);
  const campaigns = await parser.getCampaigns();
  const paths = [];

  // Read the normalized domain routing configuration
  let domainRouting: Record<string, { campaign: string; basePath: string; defaultStep?: string }> = {};
  try {
    const routingContent = fs.readFileSync(path.join(process.cwd(), 'src/domain-routing.json'), 'utf8');
    domainRouting = JSON.parse(routingContent);
  } catch (e) {
    console.warn('Could not read domain-routing.json, proceeding with defaults', e);
  }

  for (const campaignId of campaigns) {
    const base = await parser.loadCampaignBase(campaignId);

    // Load base mobile (device) overrides
    let mobileOverrides: any = {};
    try {
      mobileOverrides = await parser.loadOverrides(campaignId, 'mobile');
    } catch (e) {
      // Mobile overrides are optional
    }
    const hasMobile = Object.keys(mobileOverrides).length > 0;

    // Discover A/B variant subdirectories and load their overrides
    const variants = await parser.getVariants(campaignId);
    const variantOverridesMap: Record<string, any> = {};
    const variantMobileOverridesMap: Record<string, any> = {};

    for (const variant of variants) {
      try {
        variantOverridesMap[variant] = await parser.loadOverrides(campaignId, variant);
      } catch (e) {
        variantOverridesMap[variant] = {};
      }
      try {
        variantMobileOverridesMap[variant] = await parser.loadOverrides(campaignId, `${variant}/mobile`);
      } catch (e) {
        variantMobileOverridesMap[variant] = {};
      }
    }

    // Find all basePaths assigned to this campaign
    const basePaths = new Set<string>();
    for (const [_, routeConfig] of Object.entries(domainRouting)) {
      if (routeConfig.campaign === campaignId) {
        basePaths.add(routeConfig.basePath || `/${campaignId}`);
      }
    }
    // Default fallback if campaign isn't explicitly mapped
    if (basePaths.size === 0) {
      basePaths.add(`/${campaignId}`);
    }

    /**
     * Build the resolved props for a single page path.
     * Priority: Base < Device (mobile) < Variant < Variant+Device
     */
    function buildProps(
      stepId: string,
      isMobile: boolean,
      variant: string | null,
      hasMobileRoute: boolean,
      basePath: string,
    ) {
      const deviceOverride   = isMobile ? mobileOverrides : undefined;
      const variantOverride  = variant ? variantOverridesMap[variant] : undefined;
      const variantMobileOv  = variant && isMobile ? variantMobileOverridesMap[variant] : undefined;

      const resolvedConfig = resolveCascadingConfig(
        base,
        deviceOverride,
        variantOverride,
        variantMobileOv,
      );

      return {
        campaignId,
        stepId,
        isMobile,
        variant,
        variants,
        hasMobileRoute,
        config: resolvedConfig,
        step: resolvedConfig.steps[stepId] ?? base.steps[stepId],
        flow: resolvedConfig.flow,
        allSteps: resolvedConfig.steps,
        modalConfigs: resolvedConfig.flow?.modals ?? {},
        layout: resolvedConfig.layout ?? {},
        basePath,
        domainRouting,
      };
    }

    for (const bp of basePaths) {
      const prefix = bp === '/' ? '' : bp.replace(/^\//, '');

      // Campaign root → server-redirect to initial step (variant assignment happens client-side)
      const initialStepId = base.flow.initialStep;
      if (base.steps[initialStepId]) {
        paths.push({
          params: { slug: prefix === '' ? undefined : prefix },
          props: {
            isRedirect: true,
            redirectTo: bp === '/' ? `/${initialStepId}` : `${bp}/${initialStepId}`,
          },
        });
      }

      for (const [stepId] of Object.entries(base.steps)) {
        const stepType = base.flow.steps[stepId]?.type;
        // Popup steps render as modals inside normal pages — no dedicated routes
        if (stepType === 'popup') continue;

        const makeSlug = (suffix: string) => {
          const p = prefix ? `${prefix}/${stepId}${suffix}` : `${stepId}${suffix}`;
          return p === '' ? undefined : p;
        };

        // 1. Base desktop
        paths.push({
          params: { slug: makeSlug('') },
          props: buildProps(stepId, false, null, hasMobile, bp),
        });

        // 2. Base mobile (only if a mobile/ directory exists)
        if (hasMobile) {
          paths.push({
            params: { slug: makeSlug('.mobile') },
            props: buildProps(stepId, true, null, hasMobile, bp),
          });
        }

        // 3. Variant routes
        for (const variant of variants) {
          const vmo = variantMobileOverridesMap[variant];
          // Generate a variant mobile route when the campaign has base mobile overrides
          // OR when this variant has its own mobile overrides.
          const hasVariantMobile = hasMobile || Object.keys(vmo).length > 0;

          // Variant desktop
          paths.push({
            params: { slug: makeSlug(`.${variant}`) },
            props: buildProps(stepId, false, variant, hasVariantMobile, bp),
          });

          // Variant mobile
          if (hasVariantMobile) {
            paths.push({
              params: { slug: makeSlug(`.${variant}.mobile`) },
              props: buildProps(stepId, true, variant, hasVariantMobile, bp),
            });
          }
        }
      }
    }
  }

  return paths;
}

const {
  isRedirect,
  redirectTo,
  isMobile,
  variant,
  variants,
  hasMobileRoute,
  config,
  step,
  campaignId,
  stepId,
  flow,
  allSteps,
  modalConfigs,
  layout,
  basePath,
  domainRouting,
} = Astro.props;

// Campaign root redirect: /{campaignId} → /{campaignId}/{initialStep} or / → /{initialStep}
if (isRedirect && redirectTo) {
  return Astro.redirect(redirectTo, 302);
}

const initialState = {
  ...config.state,
  ...step.state,
  isMobile,
  variant,
  campaignId,
  stepId,
};

// Collect popup steps for ModalsContainer
const availablePopups: Record<string, any> = {};
for (const [popupId, popupStepConfig] of Object.entries(allSteps)) {
  if (flow.steps[popupId]?.type === 'popup') {
    availablePopups[popupId] = popupStepConfig;
  }
}

// Map theme colors to CSS custom properties
const themeVars = Object.entries(config.theme.colors || {}).reduce((acc, [key, val]) => {
  acc[`--color-${key}`] = val;
  return acc;
}, {} as Record<string, string>);

const faviconHref = config.theme.favicon || '/favicon.svg';
const faviconExt = faviconHref.split('?')[0].split('.').pop()?.toLowerCase() ?? '';
const faviconType: Record<string, string> = {
  svg:  'image/svg+xml',
  ico:  'image/x-icon',
  png:  'image/png',
  jpg:  'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
};
const faviconMime = faviconType[faviconExt] ?? 'image/x-icon';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type={faviconMime} href={faviconHref} />
    <meta name="viewport" content="width=device-width" />
    <title>{step.seo?.title || config.seo.title}</title>
    <meta name="description" content={step.seo?.description || config.seo.description} />
    <style>body { visibility: hidden; }</style>
    <ViewTransitions />
  </head>
  <body style={themeVars}>
    {layout?.header && (
      <header id="lander-header">
        <Registry component={layout.header.component} props={layout.header.props} />
      </header>
    )}

    <main id="lander-engine-root">
      {step.sections.map((section: any) => (
        <Registry component={section.component} props={section.props} />
      ))}
    </main>

    {layout?.footer && (
      <footer id="lander-footer">
        <Registry component={layout.footer.component} props={layout.footer.props} />
      </footer>
    )}

    <ModalsContainer popups={availablePopups} modalConfigs={modalConfigs} />

    <script>
      import '../registry-manifest';
    </script>

    <script is:inline define:vars={{ variants, hasMobileRoute, campaignId, basePath, domainRouting }}>
      (function () {
        // Register config globally
        window.__landerCampaignConfigs = window.__landerCampaignConfigs || {};
        window.__landerCampaignConfigs[campaignId] = { variants: variants, hasMobileRoute: hasMobileRoute };
        window.__landerBasePath = window.__landerBasePath || basePath || '/' + campaignId;
        window.__landerDomainRouting = window.__landerDomainRouting || domainRouting || {};

        // Execute domain level redirect if the current host is mapped to a different route
        var host = window.location.hostname;
        var hostMapping = window.__landerDomainRouting[host];
        if (hostMapping) {
          var expectedBase = hostMapping.basePath || '/' + hostMapping.campaign;
          if (expectedBase === '/') expectedBase = '';

          // If the page was loaded with a different prefix than the domain's expected base path, redirect
          if (expectedBase !== '' && !window.location.pathname.startsWith(expectedBase + '/')) {
             if (window.location.pathname === expectedBase) {
                 // valid root for the campaign
             } else {
                 var target = expectedBase + '/' + (hostMapping.defaultStep || 'main');
                 window.location.replace(target + window.location.search);
                 return;
             }
          }
        }

        // Define the shared resolver function on the window
        window.__landerResolveUrl = function(pathname) {
          if (!pathname) return null;
          
          var parts = pathname.replace(/\/$/, '').split('/').filter(Boolean);
          if (parts.length === 0) return null;

          var cId;
          var bpParts = 0;
          if (window.__landerBasePath === '/') {
              cId = campaignId;
              bpParts = 0;
          } else {
              var bpSegments = window.__landerBasePath.replace(/^\//, '').split('/');
              var match = true;
              for (var i = 0; i < bpSegments.length; i++) {
                 if (parts[i] !== bpSegments[i]) {
                     match = false;
                     break;
                 }
              }
              if (match) {
                 cId = campaignId;
                 bpParts = bpSegments.length;
              } else {
                 // Fallback for multi-campaign setups without custom domain mapping matching this request
                 cId = parts[0];
                 bpParts = 1;
              }
          }

          var config = window.__landerCampaignConfigs[cId];
          if (!config) return null;

          // Need at least one step segment
          if (parts.length <= bpParts) return null;

          var stepSlug = parts[parts.length - 1];
          var slugNoMobile = stepSlug.endsWith('.mobile') ? stepSlug.slice(0, stepSlug.length - 7) : stepSlug;

          var currentVariant = null;
          var baseStepSlug = slugNoMobile;
          
          for (var i = 0; i < config.variants.length; i++) {
            var v = config.variants[i];
            if (slugNoMobile.endsWith('.' + v)) {
              currentVariant = v;
              baseStepSlug = slugNoMobile.slice(0, slugNoMobile.length - v.length - 1);
              break;
            }
          }

          var targetVariant = currentVariant;
          if (config.variants.length > 0) {
            var stored = localStorage.getItem('lander-variant-' + cId);
            if (stored !== null && config.variants.indexOf(stored) !== -1) {
              targetVariant = stored;
            } else if (!currentVariant) {
              targetVariant = config.variants[Math.floor(Math.random() * config.variants.length)];
              localStorage.setItem('lander-variant-' + cId, targetVariant);
            }
          }

          var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
            navigator.userAgent || navigator.vendor || window.opera || ''
          );
          
          var targetMobile = config.hasMobileRoute && isMobile;

          var targetSlug = baseStepSlug;
          if (targetVariant) targetSlug += '.' + targetVariant;
          if (targetMobile)  targetSlug += '.mobile';

          if (targetSlug === stepSlug) return null; // URL is already correct
          
          parts[parts.length - 1] = targetSlug;
          return '/' + parts.join('/');
        };

        // Execute initial synchronous check
        if (window.location.search.includes('no-redirect')) {
          document.body.style.visibility = 'visible';
          return;
        }

        // If the URL doesn't need resolving (returns null), it's already correct. Unhide immediately.
        if (!window.__landerResolveUrl(window.location.pathname)) {
          document.body.style.visibility = 'visible';
        }
      })();
    </script>

    <script>
      import { navigate } from 'astro:transitions/client';

      // Expose Astro's navigate to the window for external actions
      ;(window as any).__landerNavigate = navigate;

      function rewriteLinks(): void {
        if (location.search.includes('no-redirect')) return;
        document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(a => {
          try {
            const url = new URL(a.href);
            if (url.origin !== location.origin) return;
            // Use the globally defined resolver
            const corrected = (window as any).__landerResolveUrl(url.pathname);
            if (corrected) a.href = corrected + url.search + url.hash;
          } catch { /* non-parseable href */ }
        });
      }

      document.addEventListener('click', (e: MouseEvent) => {
        if (location.search.includes('no-redirect')) return;
        const a = (e.target as Element).closest('a');
        if (!a) return;
        
        let url: URL;
        try { url = new URL((a as HTMLAnchorElement).href); } catch { return; }
        if (url.origin !== location.origin) return;
        
        const corrected = (window as any).__landerResolveUrl(url.pathname);
        if (!corrected) return;
        
        e.preventDefault();
        e.stopImmediatePropagation();
        navigate(corrected + url.search + url.hash);
      }, { capture: true });

      document.addEventListener('astro:after-swap', () => {
        if (!(window as any).__landerResolveUrl(location.pathname)) {
          document.body.style.visibility = 'visible';
        }
      });

      document.addEventListener('astro:page-load', () => {
        if (location.search.includes('no-redirect')) {
          document.body.style.visibility = 'visible';
          return;
        }
        
        const corrected = (window as any).__landerResolveUrl(location.pathname);
        if (corrected) {
          navigate(corrected + location.search);
          return;
        }
        
        document.body.style.visibility = 'visible';
        rewriteLinks();
      });
    </script>

    <script is:inline define:vars={{ initialState }}>
      document.addEventListener('click', function (e) {
        var modal = e.target.closest('.lander-modal');
        if (modal && e.target === modal) {
          if (modal.dataset.closeOnBackdrop === 'true') {
            modal.classList.add('modal-hidden');
          }
        }
      });
    </script>
  </body>
</html>